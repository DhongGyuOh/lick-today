{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Next.js: Debug Full Stack",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            // 서버가 준비될 때까지 기다렸다가 크롬을 자동으로 켭니다.
            "serverReadyAction": {
                "pattern": "started server on .+, url: (https?://.+)",
                "uriFormat": "%s",
                "action": "debugWithChrome"
            }
        }
    ]
}